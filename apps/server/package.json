{
  "name": "@3d-editor/server",
  "version": "0.1.0",
  "private": true,
  "description": "Node server: serves the PWA, real-time sync hub (Yjs), MCP endpoint, WebDAV proxy, telemetry ingestion and metrics.",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "3d-editor-server": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@3d-editor/core": "0.1.0",
    "@fastify/static": "10.1.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "@prometheus-io/client": "0.16.1",
    "fastify": "5.12.7",
    "lib0": "0.2.119",
    "pino": "10.4.0",
    "ws": "8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "webdav-server": "2.6.3"
  }
}
